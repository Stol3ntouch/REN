{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "incremental": true,
    "allowJs": false,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-f1/types/**/*.ts",
    ".next-f1/dev/types/**/*.ts",
    ".next-f2/types/**/*.ts",
    ".next-f2/dev/types/**/*.ts",
    ".next-f3/types/**/*.ts",
    ".next-f3/dev/types/**/*.ts",
    ".next-f5/types/**/*.ts",
    ".next-f5/dev/types/**/*.ts",
    ".next-f6/types/**/*.ts",
    ".next-f6/dev/types/**/*.ts",
    ".next-c01/types/**/*.ts",
    ".next-c01/dev/types/**/*.ts",
    ".next-c02/types/**/*.ts",
    ".next-c02/dev/types/**/*.ts",
    ".next-c03/types/**/*.ts",
    ".next-c03/dev/types/**/*.ts",
    ".next-c08/types/**/*.ts",
    ".next-c08/dev/types/**/*.ts",
    ".next-c11/types/**/*.ts",
    ".next-c11/dev/types/**/*.ts",
    ".next-c09/types/**/*.ts",
    ".next-c09/dev/types/**/*.ts",
    ".next-c05/types/**/*.ts",
    ".next-c05/dev/types/**/*.ts",
    ".next-c10/types/**/*.ts",
    ".next-c10/dev/types/**/*.ts",
    ".next-c06/types/**/*.ts",
    ".next-c06/dev/types/**/*.ts",
    ".next-c12/types/**/*.ts",
    ".next-c12/dev/types/**/*.ts",
    ".next-c07/types/**/*.ts",
    ".next-c07/dev/types/**/*.ts",
    ".next-c13/types/**/*.ts",
    ".next-c13/dev/types/**/*.ts",
    ".next-4700/types/**/*.ts",
    ".next-4700/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "skills-2.2.0",
    "1",
    "2",
    ".autopilot",
    "data"
  ]
}
