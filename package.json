{
  "name": "remtehsad",
  "version": "0.1.0",
  "private": true,
  "description": "Интернет-магазин «РемТехСад»",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:yml": "tsx scripts/import-yml.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "e2e:live": "tsx tests/e2e/live-check.ts",
    "a11y:live": "tsx tests/a11y/js-budget.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
