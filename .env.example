# Скопируйте в .env и заполните. Здесь только имена переменных, без значений.
# Обязательные в production: SITE_URL, SESSION_SECRET.
NODE_ENV=
SITE_URL=
SESSION_SECRET=
DATABASE_PATH=
DATA_DIR=
# TRUST_PROXY: true — сайт за своим обратным прокси (берётся последний адрес X-Forwarded-For); false — без прокси.
# В production задайте явно: иначе IP клиентов неизвестен, лимиты по IP не действуют (вход ограничивается по логину), при старте будет предупреждение в логе.
TRUST_PROXY=
IMAGE_HOST_ALLOWLIST=
# Почта (SMTP). Пока пусто — письма пишутся в email_outbox.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Интеграции (пока заглушки)
ONEC_MODE=
PAYMENT_MODE=
PAYMENT_WEBHOOK_SECRET=
DELIVERY_MODE=

# Вход и админка (T03)
# Только для разового `npm run admin:create` без интерактивного ввода; значение в файле не храните.
ADMIN_PASSWORD=

# Оплата (T06). PAYMENT_PROVIDER: пусто или test вне production = тестовая оплата; в production без выбранного провайдера онлайн-оплаты нет.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# Сборка/тесты: отдельная папка сборки Next.js, чтобы не затирать .next работающего dev-сервера.
NEXT_DIST_DIR=
# Окружение production, если NODE_ENV не используется.
APP_ENV=

# Только за прокси с TLS, не передающим верный x-forwarded-proto (тест-туннель): off/false/0 отключает редирект HTTP→HTTPS. В обычном production пусто.
HTTPS_REDIRECT=
