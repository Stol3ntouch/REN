# Скопируйте в .env и заполните. Здесь только имена переменных, без значений.
# Обязательные в production: SITE_URL, SESSION_SECRET.
NODE_ENV=
SITE_URL=
SESSION_SECRET=
DATABASE_PATH=
DATA_DIR=
TRUST_PROXY=
IMAGE_HOST_ALLOWLIST=
# Почта (SMTP). Пока пусто — письма пишутся в email_outbox.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Интеграции (пока заглушки)
ONEC_MODE=
PAYMENT_MODE=
PAYMENT_WEBHOOK_SECRET=
DELIVERY_MODE=
